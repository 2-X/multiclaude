def feed_latest(cur):
    did = str(uuid.uuid4())
    osv = run(["/usr/bin/sw_vers", "-productVersion"]).stdout.strip()
    url = f"{FEED}?device_id={did}&version={cur}&os_version={osv}"
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "multiclaude"}), timeout=30) as r:
        if r.status == 204:
            return None
        d = json.load(r)
    rel = next((x for x in d.get("releases", []) if x.get("version") == d.get("currentRelease")), None)
    return (rel or {}).get("updateTo")


def cmd_upgrade(a):
    reg = load_registry()
    vers = [version_of(i["bundle"]) for i in reg["instances"] if version_of(i["bundle"])]
    cur = min(vers, key=vtuple) if vers else "0.0.0"
    upd = feed_latest(cur)
    latest = {"checked": time.time(), "version": upd and upd["version"], "installed_min": cur,
              "size": upd and upd.get("size")}
    write_json(os.path.join(MC_DIR, "latest.json"), latest)
    if a.check:
        out({"ok": True, **latest})
        return
    if not upd:
        die("feed returned no update")
    ver = upd["version"]
    base = os.path.join(CACHE, "base", ver, "Claude.app")
    if not version_of(base):
        set_status(f"downloading Claude {ver}…")
        os.makedirs(os.path.join(CACHE, "zips"), exist_ok=True)
        z = os.path.join(CACHE, "zips", f"Claude-{ver}.zip")
        if not os.path.exists(z) or hashlib.sha256(open(z, "rb").read()).hexdigest() != upd["sha256"]:
            log(f"downloading {upd['url']}")
            run(["/usr/bin/curl", "-fsSL", "-o", z + ".part", upd["url"]])
            os.replace(z + ".part", z)
        h = hashlib.sha256(open(z, "rb").read()).hexdigest()
        if h != upd["sha256"]:
            die(f"sha256 mismatch for {z}: {h}")
        tmpd = os.path.join(CACHE, "base", ver + ".tmp")
        shutil.rmtree(tmpd, ignore_errors=True)
        run(["/usr/bin/ditto", "-x", "-k", z, tmpd])
        shutil.rmtree(os.path.dirname(base), ignore_errors=True)
        os.rename(tmpd, os.path.dirname(base))
        # Keep the stock icon art around even if /Applications/Claude.app goes away.
        shutil.copyfile(os.path.join(base, "Contents", "Resources", "electron.icns"),
                        os.path.join(CACHE, "stock-electron.icns"))
    targets = [find(reg, n) for n in a.names] if a.names else reg["instances"]
    report = []
    for inst in targets:
        if vtuple(version_of(inst["bundle"])) >= vtuple(ver) and not a.force:
            report.append({"name": inst["name"], "result": "current"})
            continue
        set_status(f"staging Claude {inst['name']} {ver}…")
        build_bundle(inst, base, staged_path(inst))
        if is_running(inst):
            queue({"op": "swap", "name": inst["name"], "wait": [inst["name"]], "relaunch": True,
                   "done_msg": f"Claude {inst['name']} upgraded to {ver}"})
            report.append({"name": inst["name"], "result": "staged; swaps in when it quits"})
        else:
            swap_in(inst, relaunch=False)
            report.append({"name": inst["name"], "result": "upgraded"})
    set_status(f"upgrade to {ver}: " + ", ".join(f"{r['name']} {r['result']}" for r in report))
    out({"ok": True, "version": ver, "report": report})


