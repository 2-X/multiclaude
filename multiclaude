def cmd_copy_routines(a):
    reg = load_registry()
    src, dst = find(reg, a.src), find(reg, a.dst)
    wait = [dst["name"]] + ([src["name"]] if a.move else [])
    if any(is_running(i) for i in (dst, src) if i["name"] in wait):
        queue({"op": "copy-routines", "name": dst["name"], "src": a.src, "dst": a.dst, "ids": a.ids,
               "move": a.move, "wait": wait, "launch_after": wait,
               "done_msg": f"Routines copied into Claude {dst['name']}"})
        out({"ok": True, "deferred": True, "msg": f"runs when {' and '.join('Claude ' + w for w in wait)} quit"})
    else:
        do_copy_routines(reg, a.src, a.dst, a.ids, a.move)
        out({"ok": True, "deferred": False})


def cmd_move_3p(a):
    reg = load_registry()
    src, dst = find(reg, a.src), find(reg, a.dst)
    queue({"op": "move-3p", "name": dst["name"], "src": src["name"], "dst": dst["name"],
           "wait": [src["name"], dst["name"]], "wait_profiles": [src["profile"] + "-3p"],
           "launch_after": [src["name"], dst["name"]] if a.launch else [],
           "done_msg": f"3p config moved {src['name']} -> {dst['name']}; both relaunched"})
    out({"ok": True, "deferred": True})


def cmd_info(a):
    inst = find(load_registry(), a.name)
    out({"ok": True, "instance": inst_view(inst), "mcp": list_mcp(inst), "routines": list_routines(inst)})


def cmd_pending(a):
    if a.cancel:
        q = [x for x in read_json(PENDING, []) if x["id"] != a.cancel]
        write_json(PENDING, q)
    out({"ok": True, "pending": read_json(PENDING, [])})


def out(obj):
    if JSON_OUT:
        print(json.dumps(obj))
    else:
        for k, v in obj.items():
            if k != "ok":
                print(f"{k}: {json.dumps(v) if isinstance(v, (dict, list)) else v}")


JSON_OUT = False


def main():
    global JSON_OUT
    p = argparse.ArgumentParser(prog="multiclaude", description=__doc__.split("\n\n")[0])
    p.add_argument("--json", action="store_true", help="machine-readable output (menubar app)")
    sp = p.add_subparsers(dest="cmd")
    sp.add_parser("list", help="instances, versions, running state, mode, pending ops")
    c = sp.add_parser("create", help="build a new instance")
    c.add_argument("name")
    c.add_argument("--color", required=True, help="icon background #RRGGBB (also tints the UI)")
    c.add_argument("--glyph", help="starburst color (default stock #FEFCFB)")
    c.add_argument("--no-tint", action="store_true", help="keep the UI pure black")
    c.add_argument("--source", help="instance name or Claude.app path to build from")
    c.add_argument("--copy-mcp-from", help="copy MCP servers/extensions from this instance")
    c.add_argument("--launch", action="store_true")
    r = sp.add_parser("recolor", help="change an instance's colors")
    r.add_argument("name"); r.add_argument("--color", required=True); r.add_argument("--glyph")
    r.add_argument("--tint", choices=["on", "off"])
    for n in ("remove", "launch", "quit", "info", "finish"):
        x = sp.add_parser(n); x.add_argument("name")
    u = sp.add_parser("upgrade", help="download latest Claude and upgrade instances (swaps on quit)")
    u.add_argument("names", nargs="*"); u.add_argument("--check", action="store_true")
    u.add_argument("--force", action="store_true")
    m = sp.add_parser("copy-mcp", help="copy desktop MCP servers + extensions between instances")
    m.add_argument("src"); m.add_argument("dst"); m.add_argument("--servers", nargs="*")
    rt = sp.add_parser("copy-routines", help="copy scheduled routines between instances")
    rt.add_argument("src"); rt.add_argument("dst"); rt.add_argument("--ids", nargs="*")
    rt.add_argument("--move", action="store_true", help="disable them at the source afterwards")
    mv = sp.add_parser("move-3p", help="give SRC's 3p (Bedrock/gateway) setup to DST; SRC back to 1p")
    mv.add_argument("src"); mv.add_argument("dst"); mv.add_argument("--launch", action="store_true")
    pe = sp.add_parser("pending"); pe.add_argument("--cancel")
    sp.add_parser("_runner")
    sp.add_parser("sync", help="rewrite side files (theme.conf, blackmode agent, bundle lists)")
    a = p.parse_args()
    JSON_OUT = a.json
    os.makedirs(MC_DIR, exist_ok=True)
    fn = {"list": cmd_list, "create": cmd_create, "recolor": cmd_recolor, "remove": cmd_remove,
          "launch": cmd_launch, "quit": cmd_quit, "info": cmd_info, "upgrade": cmd_upgrade,
          "finish": cmd_finish, "copy-mcp": cmd_copy_mcp, "copy-routines": cmd_copy_routines,
          "move-3p": cmd_move_3p, "pending": cmd_pending, "_runner": cmd_runner,
          "sync": lambda a: (save_registry(load_registry()), out({"ok": True}))}.get(a.cmd)
    if not fn:
        p.print_help()
        return
    try:
        fn(a)
    except RuntimeError as e:
        die(str(e))


if __name__ == "__main__":
    main()
