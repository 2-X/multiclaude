def cmd_create(a):
    reg = load_registry()
    os.makedirs(APPS, exist_ok=True)
    name = a.name.strip()
    if name.lower().startswith("claude "):
        name = name[7:]
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 _-]{0,30}", name):
        die("name: letters, digits, space, - or _ (max 31)")
    if any(slugify(i["name"]) == slugify(name) for i in reg["instances"]):
        die(f"instance {name!r} already exists")
    slug = slugify(name)
    inst = {"name": name, "bundle": os.path.join(APPS, f"Claude {name}.app"),
            "bundle_id": f"{BASE_ID}.{slug}", "profile": f"Claude-{name.replace(' ', '-')}",
            "color": norm_color(a.color), "glyph": norm_color(a.glyph or DEFAULT_GLYPH),
            "tint": not a.no_tint}
    if os.path.exists(inst["bundle"]):
        die(f"{inst['bundle']} already exists")
    src = pick_source(reg, a.source)
    build_bundle(inst, src, inst["bundle"])
    run([LSREGISTER, "-f", inst["bundle"]], check=False)
    reg["instances"].append(inst)
    save_registry(reg)
    gen_tint_css(inst)
    log(f"created Claude {name} ({inst['bundle_id']}, profile {inst['profile']})")
    if a.copy_mcp_from:
        do_copy_mcp(reg, a.copy_mcp_from, name)
    if a.launch:
        launch(inst)
    out({"ok": True, "instance": inst_view(inst)})


def pick_source(reg, source):
    """Newest pristine base if cached, else clone the newest existing instance."""
    if source:
        for i in reg["instances"]:
            if i["name"].lower() == source.lower():
                return i["bundle"]
        if os.path.isdir(source):
            return source
        die(f"source {source!r} is neither an instance nor an app path")
    bases = []
    bdir = os.path.join(CACHE, "base")
    for v in os.listdir(bdir) if os.path.isdir(bdir) else []:
        app = os.path.join(bdir, v, "Claude.app")
        if version_of(app):
            bases.append((vtuple(version_of(app)), app))
    # The stock /Applications/Claude.app is a pristine base too (copied, never modified).
    if version_of(STOCK_APP) and plist_get(STOCK_APP, "CFBundleIdentifier") == BASE_ID:
        bases.append((vtuple(version_of(STOCK_APP)), STOCK_APP))
    clones = [(vtuple(version_of(i["bundle"])), i["bundle"]) for i in reg["instances"] if version_of(i["bundle"])]
    best = sorted(bases + clones, key=lambda x: x[0])
    if not best:
        die("no Claude.app found: install Claude in /Applications, or run `multiclaude upgrade` to download it")
    top = best[-1][0]
    # Prefer a pristine base over a clone at the same version.
    for v, app in bases:
        if v == top:
            return app
    return best[-1][1]


