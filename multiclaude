def do_copy_mcp(reg, src_name, dst_name, only=None):
    src, dst = find(reg, src_name), find(reg, dst_name)
    sd, dd = (os.path.join(SUPPORT, active_profile_dir(i)) for i in (src, dst))
    os.makedirs(dd, exist_ok=True)
    scfg = read_json(desktop_cfg_path(src), {})
    dpath = desktop_cfg_path(dst)
    dcfg = read_json(dpath, {})
    if os.path.exists(dpath):
        shutil.copyfile(dpath, dpath + ".bak-multiclaude-" + time.strftime("%Y%m%d%H%M%S"))
    servers = scfg.get("mcpServers") or {}
    if only:
        servers = {k: v for k, v in servers.items() if k in only}
    merged = dict(dcfg.get("mcpServers") or {})
    merged.update(servers)
    dcfg["mcpServers"] = merged
    write_json(dpath, dcfg, mode=0o600)
    copied = list(servers)
    if not only:  # extensions (DXT) come along on a full copy
        for n in MCP_FILES:
            s, d = os.path.join(sd, n), os.path.join(dd, n)
            if os.path.isdir(s):
                shutil.copytree(s, d, symlinks=True, dirs_exist_ok=True)
                copied.append(n + "/")
            elif os.path.isfile(s) and not os.path.exists(d):
                shutil.copyfile(s, d)
                copied.append(n)
    log(f"copy-mcp {src['name']} -> {dst['name']}: {', '.join(copied) or 'nothing to copy'}")


def routine_files(inst):
    """scheduled-tasks.json files for this instance, newest first.

    Desktop keeps routines per account+org at
    <profile>/claude-code-sessions/<account>/<org>/scheduled-tasks.json; the
    prompt bodies (SKILL.md) live in the shared ~/.claude/scheduled-tasks.
    """
    root = os.path.join(SUPPORT, active_profile_dir(inst), "claude-code-sessions")
    out = []
    if os.path.isdir(root):
        for acct in os.listdir(root):
            for org in (os.listdir(os.path.join(root, acct)) if os.path.isdir(os.path.join(root, acct)) else []):
                p = os.path.join(root, acct, org, "scheduled-tasks.json")
                if os.path.isfile(p):
                    out.append(p)
    return sorted(out, key=os.path.getmtime, reverse=True)


def list_routines(inst):
    rows = []
    for p in routine_files(inst):
        for t in read_json(p, {}).get("scheduledTasks", []):
            rows.append({"id": t.get("id"), "name": t.get("displayName") or t.get("id"),
                         "cron": t.get("cronExpression"), "enabled": t.get("enabled", True),
                         "cwd": t.get("cwd"), "file": p})
    return rows


def do_copy_routines(reg, src_name, dst_name, ids=None, move=False):
    src, dst = find(reg, src_name), find(reg, dst_name)
    sfiles, dfiles = routine_files(src), routine_files(dst)
    if not dfiles:
        raise RuntimeError(f"{dst['name']} has no routines store yet: sign in there and open the Code tab once")
    tasks = [t for p in sfiles for t in read_json(p, {}).get("scheduledTasks", [])]
    if ids:
        tasks = [t for t in tasks if t.get("id") in ids]
    dpath = dfiles[0]
    data = read_json(dpath, {"scheduledTasks": []})
    have = {t.get("id") for t in data.get("scheduledTasks", [])}
    shutil.copyfile(dpath, dpath + ".bak-multiclaude-" + time.strftime("%Y%m%d%H%M%S"))
    added = []
    for t in tasks:
        if t.get("id") in have:
            continue
        nt = {k: v for k, v in t.items() if k not in ("lastRunAt", "lastScheduledFor", "notifySessionId")}
        nt["createdAt"] = int(time.time() * 1000)
        data.setdefault("scheduledTasks", []).append(nt)
        added.append(t.get("id"))
    write_json(dpath, data, mode=0o600)
    if move and added:  # disable (never delete) at the source so it can't double-fire
        for p in sfiles:
            sd = read_json(p, {})
            changed = False
            for t in sd.get("scheduledTasks", []):
                if t.get("id") in added and t.get("enabled", True):
                    t["enabled"] = False
                    changed = True
            if changed:
                shutil.copyfile(p, p + ".bak-multiclaude-" + time.strftime("%Y%m%d%H%M%S"))
                write_json(p, sd, mode=0o600)
    log(f"copy-routines {src['name']} -> {dst['name']}: added {added or 'none'}"
        f"{' (disabled at source)' if move and added else ''}")


def do_move_3p(reg, op):
    """Hand a profile's 3p (gateway/Bedrock) config to another instance.

    The app keeps 3p state in <profile>-3p and runs in 3p mode whenever a
    config is applied there, which is what made Claude Work lose its claude.ai
    account. Moving the whole dir gives the 3p setup (incl. its Code sessions)
    to the target, and the source is pinned to 1p.
    """
    src, dst = find(reg, op["src"]), find(reg, op["dst"])
    s3 = os.path.join(SUPPORT, src["profile"] + "-3p")
    d3 = os.path.join(SUPPORT, dst["profile"] + "-3p")
    if mode_of(dst).startswith("3p"):
        # The target already got its own gateway config (e.g. set up by hand);
        # moving would shove it aside, so leave both as they are.
        log(f"move-3p skipped: {dst['name']} is already {mode_of(dst)}")
        return
    if not os.path.isdir(s3):
        raise RuntimeError(f"{s3} does not exist")
    if os.path.exists(d3):
        os.rename(d3, d3 + ".pre-move-" + time.strftime("%Y%m%d%H%M%S"))
    os.makedirs(os.path.join(SUPPORT, dst["profile"]), exist_ok=True)
    os.rename(s3, d3)
    os.makedirs(s3, mode=0o700)
    write_json(os.path.join(s3, "claude_desktop_config.json"), {"deploymentMode": "1p"}, mode=0o600)
    log(f"move-3p: {s3} -> {d3}; {src['name']} pinned to 1p")


